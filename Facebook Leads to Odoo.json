      "parameters": {
        "jsCode": "// ===== LIVE LEADS: Dynamic Mapping for All Campaigns =====\n\nconst formMap = {\n  \"2131862044297939\":  \"home cinema\",\n  \"2747484365591298\":  \"smart kitchen\",\n  \"1954878498407649\":  \"automated chat\",\n  \"2311009299338587\":  \"lvx meeting room\",\n  \"24734201116271722\": \"lvx 1-me3margy\",\n  \"1061737452708002\":  \"lvx 1-hotel\",\n  \"1142853107741031\":  \"lvx 1\",\n  \"486711127779558\":   \"security cam\",\n  \"1253045706115319\":  \"parking system\",\n  \"1016668106364456\":  \"knx course\",\n  \"1216387276066675\":  \"smart doorlock\",\n  \"858762189437779\":   \"vacuum cleaner\",\n  \"769786918561397\":   \"vacuum cleaner edit\",\n  \"1435240593773697\":  \"vacuum cleaner copy\",\n  \"366255539803981\":   \"untitled form\",\n};\n\n// الداتا الجاية من فيسبوك تريجر\nconst lead = $input.first().json;\nconst formId = lead.form_id;\nconst formName = formMap[formId] || \"General Facebook Lead\";\n\nconst result = {\n  fb_lead_id: lead.id,\n  created_at: lead.created_time,\n  form_id:    formId,\n  form_name:  formName,\n};\n\n// فك البيانات (Full Name, Phone, etc)\nif (lead.field_data) {\n  lead.field_data.forEach(field => {\n    if (field.values && field.values.length > 0) {\n      result[field.name] = field.values[0];\n    }\n  });\n}\n\n// تنسيق اسم الفرصة اللي هيظهر في أودو\n// النتيجة هتكون مثلاً: عاصم أحمد - home cinema\nresult.opportunity_name = `${result.full_name || 'New Lead'} - ${formName}`;\n\n// تحديد المسؤول (Salesperson ID)\nresult.assigned_user_id = 725; \n\nreturn { json: result };"
      },
